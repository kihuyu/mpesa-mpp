# Leave DARAJA_CONSUMER_KEY empty to run the examples against the built-in pretend Safaricom.
# Fill these in (from developer.safaricom.co.ke) to use the real Daraja sandbox.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=

# Generate with: openssl rand -base64 32
MPP_SECRET_KEY=

# Safaricom must reach this for callbacks (https only). Locally, use a tunnel:
#   npm run sandbox:check   → ngrok http 3010
#   example servers         → ngrok http 3001 (Soko Bei) or 3002 (Mvua)
PUBLIC_URL=
CALLBACK_PORT=3010
# Generate with: openssl rand -hex 16
CALLBACK_TOKEN=

# Your own Safaricom number: the sandbox sends real prompts to it (no money moves).
MPESA_PHONE=

# Set to "simulated" to skip Open-Meteo in the weather example.
WEATHER_SOURCE=
